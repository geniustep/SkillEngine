# ==========================================
# SkillEngine - Full Stack Environment
# Domain: skill.geniura.com
# ==========================================

# ==========================================
# Database
# ==========================================
DB_PASSWORD=your_secure_db_password

# ==========================================
# Redis
# ==========================================
REDIS_PASSWORD=your_secure_redis_password

# ==========================================
# JWT Secrets
# ==========================================
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_characters

# ==========================================
# NextAuth
# ==========================================
NEXTAUTH_SECRET=your_nextauth_secret_key_min_32_characters

# ==========================================
# Keycloak Authentication
# ==========================================
KEYCLOAK_URL=https://auth.geniura.com
KEYCLOAK_REALM=skillengine
KEYCLOAK_CLIENT_ID=skillengine-dashboard
KEYCLOAK_CLIENT_SECRET=your_keycloak_client_secret

# ==========================================
# Pusher Real-time
# ==========================================
PUSHER_APP_ID=your_pusher_app_id
PUSHER_KEY=your_pusher_key
PUSHER_SECRET=your_pusher_secret
PUSHER_CLUSTER=eu

# ==========================================
# Daily.co Video Conferencing
# ==========================================
DAILY_API_KEY=your_daily_api_key
DAILY_DOMAIN=geniura.daily.co

# ==========================================
# AWS S3 Storage
# ==========================================
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
S3_BUCKET_NAME=skillengine-files
S3_CDN_URL=https://cdn.geniura.com

# ==========================================
# MinIO (Local Development)
# ==========================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ==========================================
# Let's Encrypt (Production)
# ==========================================
ACME_EMAIL=admin@geniura.com

