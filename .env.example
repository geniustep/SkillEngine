# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Academy LMS Admin

# API
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_TIMEOUT=30000

# Auth (Keycloak)
KEYCLOAK_URL=https://your-keycloak.com
KEYCLOAK_REALM=academy-lms
KEYCLOAK_CLIENT_ID=admin-dashboard
KEYCLOAK_CLIENT_SECRET=your-secret-here

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here-generate-with-openssl-rand-base64-32

# Real-time (Pusher)
NEXT_PUBLIC_PUSHER_KEY=your-pusher-key
NEXT_PUBLIC_PUSHER_CLUSTER=us2
PUSHER_APP_ID=your-app-id
PUSHER_SECRET=your-pusher-secret

# Integrations
ODOO_URL=https://your-odoo-instance.com
ODOO_API_KEY=your-odoo-api-key
DAILY_API_KEY=your-daily-api-key
BBB_URL=https://your-bbb-instance.com/bigbluebutton
BBB_SECRET=your-bbb-secret
MINIO_ENDPOINT=your-minio-endpoint
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key

# Feature Flags
NEXT_PUBLIC_FEATURE_REAL_TIME=true
NEXT_PUBLIC_FEATURE_ANALYTICS_ADVANCED=true
