// ==========================================
// Prisma Schema - Academy LMS
// ==========================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// Enums
// ==========================================

enum UserRole {
  student
  instructor
  admin
  super_admin
  content_manager
  pedagogic_manager
  viewer
}

enum UserStatus {
  active
  inactive
  suspended
}

enum CourseStatus {
  draft
  published
  archived
}

enum CourseLevel {
  beginner
  intermediate
  advanced
}

enum CurriculumType {
  module
  lesson
  quiz
  assignment
}

enum SessionStatus {
  scheduled
  live
  completed
  cancelled
  rescheduled
}

enum LivePlatform {
  daily
  bbb
  zoom
  teams
}

enum EnrollmentStatus {
  active
  completed
  dropped
  expired
  suspended
}

enum AttendanceStatus {
  present
  absent
  late
  excused
}

enum NotificationType {
  enrollment
  session
  assignment
  announcement
  system
  reminder
}

enum NotificationPriority {
  low
  medium
  high
}

enum TenantStatus {
  active
  suspended
  trial
  cancelled
}

enum SubscriptionPlan {
  free
  basic
  premium
  enterprise
}

enum AnalyticsMetric {
  enrollments
  completions
  revenue
  active_users
  sessions
  engagement
}

// ==========================================
// Models
// ==========================================

model Tenant {
  id                    String           @id @default(uuid())
  name                  String
  slug                  String           @unique
  domain                String?          @unique
  logo                  String?
  settings              Json             @default("{}")
  status                TenantStatus     @default(active)
  subscriptionPlan      SubscriptionPlan @default(free)
  subscriptionExpiresAt DateTime?
  ownerId               String?
  owner                 User?            @relation("TenantOwner", fields: [ownerId], references: [id])
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  deletedAt             DateTime?

  // Relations
  users         User[]         @relation("TenantUsers")
  courses       Course[]
  sessions      Session[]
  enrollments   Enrollment[]
  notifications Notification[]
  analytics     Analytics[]
  auditLogs     AuditLog[]

  @@index([slug])
  @@index([status])
  @@map("tenants")
}

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  password        String?    // For local auth (hashed)
  firstName       String
  lastName        String
  phone           String?
  avatar          String?
  role            UserRole   @default(student)
  status          UserStatus @default(active)
  bio             String?    @db.Text
  keycloakId      String?    @unique // Optional for local auth
  tenantId        String
  tenant          Tenant     @relation("TenantUsers", fields: [tenantId], references: [id])
  dateOfBirth     DateTime?
  address         String?
  city            String?
  country         String?
  zipCode         String?
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  metadata        Json       @default("{}")
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  // Relations
  ownedTenants       Tenant[]            @relation("TenantOwner")
  instructor         Instructor?
  coursesAsInstructor Course[]           @relation("CourseInstructor")
  sessionsAsInstructor Session[]         @relation("SessionInstructor")
  enrollments        Enrollment[]
  attendances        SessionAttendance[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  lessonProgress     LessonProgress[]

  @@index([email])
  @@index([keycloakId])
  @@index([tenantId])
  @@index([role, status])
  @@map("users")
}

model Instructor {
  id             String    @id @default(uuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String?
  specialization String[]
  biography      String    @db.Text
  expertise      String[]
  certifications Json      @default("[]")
  socialLinks    Json      @default("{}")
  hourlyRate     Decimal?  @db.Decimal(10, 2)
  availability   Json      @default("{}")
  rating         Decimal?  @db.Decimal(2, 1)
  reviewCount    Int       @default(0)
  totalStudents  Int       @default(0)
  totalCourses   Int       @default(0)
  isVerified     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@index([userId])
  @@index([isVerified])
  @@index([rating])
  @@map("instructors")
}

model Course {
  id               String       @id @default(uuid())
  title            String
  slug             String       @unique
  shortDescription String?      @db.VarChar(200)
  description      String       @db.Text
  thumbnail        String?
  coverImage       String?
  category         String?
  level            CourseLevel  @default(beginner)
  language         String       @default("ar")
  price            Decimal      @default(0) @db.Decimal(10, 2)
  discountPrice    Decimal?     @db.Decimal(10, 2)
  duration         Int          @default(0) // minutes
  status           CourseStatus @default(draft)
  featured         Boolean      @default(false)
  instructorId     String
  instructor       User         @relation("CourseInstructor", fields: [instructorId], references: [id])
  tenantId         String
  tenant           Tenant       @relation(fields: [tenantId], references: [id])
  metadata         Json         @default("{}")
  enrollmentCount  Int          @default(0)
  rating           Decimal?     @db.Decimal(2, 1)
  reviewCount      Int          @default(0)
  publishedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  // Relations
  curriculum  CourseCurriculum[]
  sessions    Session[]
  enrollments Enrollment[]
  reviews     CourseReview[]

  @@index([slug])
  @@index([instructorId])
  @@index([tenantId])
  @@index([status, featured])
  @@index([category, level])
  @@map("courses")
}

model CourseCurriculum {
  id          String         @id @default(uuid())
  courseId    String
  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?        @db.Text
  type        CurriculumType @default(lesson)
  parentId    String?
  parent      CourseCurriculum? @relation("CurriculumHierarchy", fields: [parentId], references: [id])
  children    CourseCurriculum[] @relation("CurriculumHierarchy")
  order       Int
  duration    Int?           // minutes
  content     Json           @default("{}")
  isFree      Boolean        @default(false)
  isPublished Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  // Relations
  progress LessonProgress[]

  @@index([courseId, order])
  @@index([parentId])
  @@map("course_curriculum")
}

model Session {
  id                  String        @id @default(uuid())
  title               String
  description         String?       @db.Text
  courseId            String?
  course              Course?       @relation(fields: [courseId], references: [id])
  instructorId        String
  instructor          User          @relation("SessionInstructor", fields: [instructorId], references: [id])
  scheduledStart      DateTime
  scheduledEnd        DateTime
  actualStart         DateTime?
  actualEnd           DateTime?
  status              SessionStatus @default(scheduled)
  platform            LivePlatform  @default(daily)
  meetingUrl          String?
  meetingId           String?
  maxParticipants     Int?
  currentParticipants Int           @default(0)
  recordingUrl        String?
  tenantId            String
  tenant              Tenant        @relation(fields: [tenantId], references: [id])
  metadata            Json          @default("{}")
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  deletedAt           DateTime?

  // Relations
  attendances SessionAttendance[]

  @@index([courseId])
  @@index([instructorId])
  @@index([scheduledStart, scheduledEnd])
  @@index([status])
  @@index([tenantId])
  @@map("sessions")
}

model SessionAttendance {
  id        String           @id @default(uuid())
  sessionId String
  session   Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  joinedAt  DateTime?
  leftAt    DateTime?
  duration  Int?             // minutes
  status    AttendanceStatus @default(absent)
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
  @@map("session_attendances")
}

model Enrollment {
  id               String           @id @default(uuid())
  studentId        String
  student          User             @relation(fields: [studentId], references: [id])
  courseId         String
  course           Course           @relation(fields: [courseId], references: [id])
  tenantId         String
  tenant           Tenant           @relation(fields: [tenantId], references: [id])
  status           EnrollmentStatus @default(active)
  progress         Int              @default(0) // 0-100
  completedLessons Json             @default("[]")
  lastAccessedAt   DateTime?
  completedAt      DateTime?
  expiresAt        DateTime?
  enrolledAt       DateTime         @default(now())
  certificateUrl   String?
  grade            Decimal?         @db.Decimal(5, 2)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  @@unique([studentId, courseId])
  @@index([studentId, status])
  @@index([courseId, status])
  @@index([enrolledAt])
  @@index([tenantId])
  @@map("enrollments")
}

model LessonProgress {
  id           String           @id @default(uuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id])
  curriculumId String
  curriculum   CourseCurriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  status       String           @default("not_started") // not_started, in_progress, completed
  completedAt  DateTime?
  timeSpent    Int              @default(0) // seconds
  score        Decimal?         @db.Decimal(5, 2)
  metadata     Json             @default("{}")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([userId, curriculumId])
  @@index([userId])
  @@index([curriculumId])
  @@map("lesson_progress")
}

model CourseReview {
  id        String   @id @default(uuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId    String
  rating    Int      // 1-5
  comment   String?  @db.Text
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@unique([courseId, userId])
  @@index([courseId])
  @@map("course_reviews")
}

model Notification {
  id        String               @id @default(uuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant               @relation(fields: [tenantId], references: [id])
  type      NotificationType     @default(system)
  title     String
  message   String               @db.Text
  data      Json                 @default("{}")
  isRead    Boolean              @default(false)
  readAt    DateTime?
  priority  NotificationPriority @default(medium)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([userId, isRead])
  @@index([createdAt(sort: Desc)])
  @@index([type])
  @@index([tenantId])
  @@map("notifications")
}

model Analytics {
  id        String          @id @default(uuid())
  tenantId  String
  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  date      DateTime        @db.Date
  metric    AnalyticsMetric
  value     Decimal         @db.Decimal(15, 2)
  metadata  Json            @default("{}")
  createdAt DateTime        @default(now())

  @@unique([tenantId, date, metric])
  @@index([date(sort: Desc)])
  @@map("analytics")
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String   // create, update, delete, login, logout, etc.
  resource   String   // users, courses, sessions, etc.
  resourceId String?
  oldData    Json?
  newData    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([resource, resourceId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

