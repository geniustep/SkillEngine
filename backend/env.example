# ==========================================
# Application
# ==========================================
NODE_ENV=development
PORT=8000
API_VERSION=v1
APP_NAME="SkillEngine API"
APP_URL=https://skill.geniura.com
FRONTEND_URL=https://skill.geniura.com

# ==========================================
# Database (PostgreSQL)
# ==========================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/academy_lms?schema=public"
DB_POOL_MIN=2
DB_POOL_MAX=10

# ==========================================
# Redis
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600

# ==========================================
# Keycloak Authentication
# ==========================================
KEYCLOAK_URL=https://keycloak.yourdomain.com
KEYCLOAK_REALM=academy-lms
KEYCLOAK_CLIENT_ID=admin-dashboard
KEYCLOAK_CLIENT_SECRET=your-client-secret
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_CLIENT_SECRET=your-admin-secret

# ==========================================
# JWT
# ==========================================
JWT_SECRET=your-super-secret-key-min-32-characters-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-key-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# AWS S3 / MinIO Storage
# ==========================================
STORAGE_PROVIDER=minio
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=academy-lms
S3_ENDPOINT=http://localhost:9000
S3_CDN_URL=http://localhost:9000/academy-lms
S3_FORCE_PATH_STYLE=true

# ==========================================
# Daily.co Video Conferencing
# ==========================================
DAILY_API_KEY=your-daily-api-key
DAILY_DOMAIN=yourdomain.daily.co
DAILY_API_URL=https://api.daily.co/v1

# ==========================================
# BigBlueButton (Alternative)
# ==========================================
BBB_URL=https://bbb.yourdomain.com/bigbluebutton/api
BBB_SECRET=your-bbb-secret

# ==========================================
# Pusher Real-time
# ==========================================
PUSHER_APP_ID=your-app-id
PUSHER_KEY=your-key
PUSHER_SECRET=your-secret
PUSHER_CLUSTER=eu

# ==========================================
# Email (SendGrid)
# ==========================================
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM=noreply@geniura.com
EMAIL_FROM_NAME="SkillEngine"

# ==========================================
# Monitoring & Logging
# ==========================================
SENTRY_DSN=
LOG_LEVEL=debug
LOG_FORMAT=pretty

# ==========================================
# Rate Limiting
# ==========================================
THROTTLE_TTL=60
THROTTLE_LIMIT=100
AUTH_THROTTLE_TTL=60
AUTH_THROTTLE_LIMIT=5

# ==========================================
# CORS
# ==========================================
CORS_ORIGINS=http://localhost:3000,https://skill.geniura.com

# ==========================================
# File Upload Limits
# ==========================================
MAX_FILE_SIZE_IMAGE=5242880
MAX_FILE_SIZE_VIDEO=524288000
MAX_FILE_SIZE_DOCUMENT=10485760

# ==========================================
# Pagination
# ==========================================
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

