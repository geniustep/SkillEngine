# ==========================================
# SkillEngine Secrets Template
# Copy to secrets.yaml and fill in values
# ==========================================
apiVersion: v1
kind: Secret
metadata:
  name: skillengine-secrets
  namespace: skillengine
type: Opaque
stringData:
  # Database
  POSTGRES_USER: "postgres"
  POSTGRES_PASSWORD: "CHANGE_ME_STRONG_PASSWORD"
  DATABASE_URL: "postgresql://postgres:CHANGE_ME_STRONG_PASSWORD@skillengine-db:5432/skillengine?schema=public"
  
  # Redis
  REDIS_PASSWORD: ""
  
  # JWT
  JWT_SECRET: "CHANGE_ME_MIN_32_CHARS_SECRET_KEY"
  
  # Keycloak
  KEYCLOAK_CLIENT_ID: "skillengine-api"
  KEYCLOAK_CLIENT_SECRET: "CHANGE_ME_KEYCLOAK_SECRET"
  
  # MinIO
  MINIO_ACCESS_KEY: "admin"
  MINIO_SECRET_KEY: "CHANGE_ME_MINIO_SECRET"
  
  # NextAuth
  NEXTAUTH_SECRET: "CHANGE_ME_NEXTAUTH_SECRET"
  
  # Daily.co (Video Conferencing)
  DAILY_API_KEY: ""
  DAILY_DOMAIN: ""
  
  # Pusher (Real-time)
  PUSHER_APP_ID: ""
  PUSHER_KEY: ""
  PUSHER_SECRET: ""
  PUSHER_CLUSTER: "eu"

